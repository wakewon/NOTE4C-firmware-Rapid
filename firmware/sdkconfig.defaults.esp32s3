
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

CONFIG_ZECTRIX_EPD_PANEL_4COLOR_SSD2683=y
# CONFIG_ZECTRIX_EPD_4COLOR_BOOT_TEST_PATTERN is not set
CONFIG_ZECTRIX_EPD_FAST_BW=y
CONFIG_ZECTRIX_EPD_FAST_BW_IDLE_FULL_SECONDS=30
CONFIG_ZECTRIX_EPD_FAST_BW_QUALITY_FULL_SECONDS=10
CONFIG_ZECTRIX_EPD_FAST_BY_MIN_PERIOD_MS=4000
CONFIG_ZECTRIX_EPD_FAST_BY_PAGE_CHANGE_PERCENT=30
CONFIG_ZECTRIX_EPD_FAST_BY_CLEANUP_INTERVAL=10
CONFIG_ZECTRIX_EPD_READ_CLOCK_HZ=1000000

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# Bluetooth BLE
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# Console on the USB-Serial-JTAG port only. UART0 at 115200 baud was the
# primary console with nothing attached to it, and every log line beyond its
# 128-byte FIFO busy-waited the CPU at 240 MHz: about 0.6 s of each wake. USB
# output is fast with a host and dropped after one 50 ms timeout without one.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Power management: frequency scaling everywhere, auto light sleep only inside
# the application's low-power wait window (Application::UpdateLowPowerWait).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
# Sleep through idle gaps from 20 ms up. With several 0.5-1 s periodic
# tasks still running in the window, gaps of 20-30 ms are common.
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=2
